    <string name="board_pinouts_limit_fivevolttolerant_explain">Verträgt ein 5-V-Eingangssignal.</string>
    <string name="board_pinouts_limit_threevoltonly">Nur 3,3 V</string>
    <string name="board_pinouts_limit_threevoltonly_explain">Nicht 5-V-tolerant: ein 5-V-Signal kann den Chip beschädigen. Pegelwandler oder Teiler verwenden.</string>
